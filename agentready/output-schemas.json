{
  "_note": "Proposed outputSchema per market tool. Observed from live responses on 13 Nov 2026, except swap_status (no public sample trade; confirm field names against the server before merge). Array results are wrapped in an object because MCP structuredContent must be an object.",
  "tools": {
    "search_tokens": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chainId": {
                "type": "number"
              },
              "address": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "priceUsd": {
                "type": "number"
              },
              "fdvUsd": {
                "type": "number"
              },
              "liquidityUsd": {
                "type": "number"
              },
              "volume24h": {
                "type": "number"
              },
              "change5m": {
                "type": "number"
              },
              "change1h": {
                "type": "number"
              },
              "change24h": {
                "type": "number"
              },
              "venue": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "verifiedByWarden": {
                "type": "boolean"
              },
              "establishedAsset": {
                "type": "boolean"
              }
            },
            "required": [
              "chainId",
              "address",
              "symbol",
              "name"
            ]
          }
        }
      },
      "required": [
        "tokens"
      ]
    },
    "trending_tokens": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chainId": {
                "type": "number"
              },
              "address": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "priceUsd": {
                "type": "number"
              },
              "fdvUsd": {
                "type": "number"
              },
              "liquidityUsd": {
                "type": "number"
              },
              "volume24h": {
                "type": "number"
              },
              "change5m": {
                "type": "number"
              },
              "change1h": {
                "type": "number"
              },
              "change24h": {
                "type": "number"
              },
              "venue": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "verifiedByWarden": {
                "type": "boolean"
              },
              "establishedAsset": {
                "type": "boolean"
              }
            },
            "required": [
              "chainId",
              "address",
              "symbol",
              "name"
            ]
          }
        }
      },
      "required": [
        "tokens"
      ]
    },
    "price_history": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "chainId": {
          "type": "number"
        },
        "token": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "pool": {
          "type": "string"
        },
        "interval": {
          "type": "string",
          "enum": [
            "5m",
            "15m",
            "1h",
            "4h",
            "1d"
          ]
        },
        "summary": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            },
            "lastClose": {
              "type": "number"
            },
            "changePct": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "low": {
              "type": "number"
            },
            "belowHighPct": {
              "type": "number"
            },
            "aboveLowPct": {
              "type": "number"
            },
            "volume": {
              "type": "number"
            }
          }
        },
        "candles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "integer",
                "description": "unix seconds"
              },
              "open": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              },
              "volume": {
                "type": "number"
              }
            },
            "required": [
              "time",
              "open",
              "high",
              "low",
              "close",
              "volume"
            ]
          }
        }
      },
      "required": [
        "chainId",
        "token",
        "interval",
        "summary",
        "candles"
      ]
    },
    "quote_swap": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "buyAmount": {
          "type": "string",
          "description": "smallest unit"
        },
        "minBuyAmount": {
          "type": "string"
        },
        "liquidityAvailable": {
          "type": "boolean"
        },
        "approxValueUsd": {
          "type": "number"
        },
        "gasless": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "buyAmount",
        "liquidityAvailable"
      ]
    },
    "swap_status": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gasless",
            "cross_chain",
            "solana"
          ]
        },
        "status": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "chainId": {
          "type": "number"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    }
  }
}
